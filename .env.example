# --- Application ---
PORT="3000"
SERVER_PORT="3001"
APP_URL="http://localhost:3000"

# --- Database ---
# Uses embedded PGlite persisted under ./data/pgdata by default for zero-config local execution.
# Switch to postgresql://postgres:postgres@localhost:5432/postgres when using external Postgres.
DATABASE_URL="pglite://./data/pgdata"
STRICT_SCHEMA_CHECK="false"

# --- Storage ---
STORAGE_BACKEND="local"
# LOCAL_STORAGE_PATH defaults to <workspace>/data when unset.

# --- Local Auth & Security Secrets ---
AUTH_SECRET="local-ats-resume-studio-auth-secret-key-32chars"
ENCRYPTION_SECRET="local-ats-resume-studio-encryption-key-32chars"

# --- Local AI (OpenAI-compatible) ---
# Windows (Ollama): http://127.0.0.1:11434/v1
# MacBook Air (Bionic): http://127.0.0.1
AI_PROVIDER="openai-compatible"
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_MODEL_NAME="qwen2.5:7b-instruct"
AI_MODEL="qwen2.5:7b-instruct"
AI_API_KEY="local"

# --- Master Dossier (optional override) ---
# Loads both apps/server/src/assets/profile.md and apps/server/src/assets/master-profile.json by default.
# MASTER_PROFILE_PATH=""

# --- Local Development Flags ---
FLAG_ALLOW_UNSAFE_AI_BASE_URL="true"
FLAG_DISABLE_API_RATE_LIMIT="true"
AI_AGENT_STEP_TIMEOUT_MS="120000"
AI_AGENT_RUN_TIMEOUT_MS="240000"
